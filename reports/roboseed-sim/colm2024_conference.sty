\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{colm2024_conference}[2026/08/19 PrimitiveX technical report style]

% Fonts inherited from the original report template.
\RequirePackage{tgpagella}
\RequirePackage{mathpazo}
\RequirePackage{inconsolata}

% Core layout and report features.
\RequirePackage{graphicx}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fancyhdr}
\RequirePackage{xcolor}
\RequirePackage{natbib}
\RequirePackage[a4paper,margin=2.5cm,headheight=24pt]{geometry}
\RequirePackage[style=iso]{datetime2}
\RequirePackage{microtype}
\RequirePackage{hyperref}
\RequirePackage{url}

\definecolor{darkblue}{HTML}{0066CC}
\definecolor{abstractbluebg}{RGB}{230,242,255}
\hypersetup{
  colorlinks=true,
  citecolor=darkblue,
  linkcolor=darkblue,
  urlcolor=darkblue,
  linktoc=section
}
\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}

\renewcommand{\topfraction}{0.95}
\renewcommand{\textfraction}{0.05}

% Title wrapper.
\def\maketitle{\par
\begingroup
  \def\thefootnote{\fnsymbol{footnote}}
  \def\@makefnmark{\hbox to 0pt{$^{\@thefnmark}$\hss}}
  \long\def\@makefntext##1{\parindent 1em\noindent
    \hbox to1.8em{\hss $\m@th ^{\@thefnmark}$}##1}
  \@maketitle \@thanks
\endgroup
\setcounter{footnote}{0}
\let\maketitle\relax
\let\@maketitle\relax
\gdef\@thanks{}
\gdef\@author{}
\gdef\@title{}
\let\thanks\relax}

